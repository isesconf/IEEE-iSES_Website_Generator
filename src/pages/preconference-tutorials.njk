---
layout: layouts/base.njk
pageTitle: "iSES"
bodyClass: "homepage is-preload"
---

<div id="page-wrapper">

  <section class="wrapper style2" id="intro">

    <div class="title">Preconference Tutorials</div>

    <div class="container">

      {% if tutorials.enabled and tutorials.schedule.length %}

      <p>
        The iSES 2026 Preconference Tutorials will be held
        on <strong>13–14 December 2026</strong>.
        The tutorial topics and speakers are listed below.
      </p>

      <div style="overflow-x: auto;">

        <table>
          <thead>
            <tr>
              <th>Speaker and Designation</th>
              <th>Tutorial Title</th>
            </tr>
          </thead>

          <tbody>

            {% for tutorial in tutorials.schedule %}

            <tr>

              <td>

                {% for speaker in tutorial.speakers %}

                  <strong>{{ speaker.name }}</strong>

                  {% if speaker.role == "Co-presenter" %}
                    (Co-presenter)
                  {% endif %}

                  {% if speaker.affiliation %}
                    <br>
                    {{ speaker.affiliation }}
                  {% endif %}

                  {% if not loop.last %}
                    <br><br>
                  {% endif %}

                {% endfor %}

              </td>

              <td>
                <a href="#{{ tutorial.id }}"
                   class="inline-a7988c6e19">
                  {{ tutorial.title }}
                </a>
              </td>

            </tr>

            {% endfor %}

          </tbody>
        </table>

      </div>

    </div>

    <div class="container">

      {% for tutorial in tutorials.schedule %}

      <div class="tutorial" style="margin-bottom: 3em;">

        <h2 id="{{ tutorial.id }}">
          {{ tutorial.title }}
        </h2>

        {% if tutorial.abstract %}

        <div class="bio" style="margin: 1.5em 0;">

          <h3>Abstract</h3>

          <p style="white-space: pre-line;">
            {{ tutorial.abstract }}
          </p>

        </div>

        {% endif %}

        <div class="speakers">

          {% for speaker in tutorial.speakers %}

          <div class="speaker"
               style="margin: 2em 0;">

            {% if speaker.photo %}

            <img
              class="speaker-img"
              src="{{ speaker.photo }}"
              alt="Photograph of {{ speaker.name }}"
              loading="lazy"
              style="
                width: 160px;
                height: 180px;
                object-fit: cover;
                float: left;
                margin: 0 24px 20px 0;
                border-radius: 5px;
              ">

            {% endif %}

            <div class="speaker-info">

              <h3>{{ speaker.name }}</h3>

              {% if speaker.role %}
              <p>
                <strong>{{ speaker.role }}</strong>
              </p>
              {% endif %}

              {% if speaker.affiliation %}
              <p>{{ speaker.affiliation }}</p>
              {% endif %}

              {% if speaker.url %}
              <p>
                <a href="{{ speaker.url }}"
                   target="_blank"
                   rel="noopener noreferrer">
                  View Profile
                </a>
              </p>
              {% endif %}

              {% if speaker.bio %}

              <div class="bio">

                <h4>Biography</h4>

                <p style="white-space: pre-line; text-align: justify;">
                  {{ speaker.bio }}
                </p>

              </div>

              {% endif %}

            </div>

            <div style="clear: both;"></div>

          </div>

          {% endfor %}

        </div>

      </div>

      <hr>

      {% endfor %}

    </div>

    {% else %}

    <div class="container">
      <h2>Will be announced soon.</h2>
    </div>

    {% endif %}

  </section>


</div>
