---
layout: layouts/base.njk
pageTitle: "iSES"
---

<div id="page-wrapper">
  <section class="wrapper style2" id="intro">
    <div class="title">Keynotes</div>

    <div class="container">
      {% for sp in keynotes %}
        <div class="card keynote" id="{{ sp.id }}">
          <div class="card-body">

            <div class="keynote-grid">
              <div>
                {% if sp.photo %}
                  <img
                    class="keynote-photo"
                    src="{{ site.basePath }}{{ sp.photo }}"
                    alt="{{ sp.name }}"
                  >
                {% endif %}
              </div>

              <div class="stack">
                <div>
                  <div class="keynote-name">{{ sp.name }}</div>

                  <div class="muted">
                    {% for line in sp.affiliation %}
                      <div>{{ line }}</div>
                    {% endfor %}
                  </div>
                </div>

                {% if sp.title and sp.title != "" %}
                  <div>
                    <div class="section-label">Title</div>
                    <div class="muted">{{ sp.title }}</div>
                  </div>
                {% endif %}
              </div>
            </div>

            {% if sp.abstract_html and sp.abstract_html != "" %}
              <div class="section-label">Abstract</div>
              <div class="prose">{{ sp.abstract_html | safe }}</div>
            {% endif %}

            <div class="section-label">Speaker Biography</div>
            <div class="prose">{{ sp.bio_html | safe }}</div>

          </div>
        </div>
      {% endfor %}
    </div>
  </section>
</div>